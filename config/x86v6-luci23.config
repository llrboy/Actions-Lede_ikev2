# LEDE x86_64 Generic
# REPO: https://github.com/coolsnowwolf/lede
#
# 目标：
#   x86_64 Generic
#   BIOS / GRUB combined.img.gz
#   SquashFS
#   Kernel 64 MiB
#   RootFS 960 MiB
#
# 功能：
#   OpenClash
#   Samba4
#   Diskman
#   IPSec strongswan IKEv2 EAP-MSCHAPv2(安卓手机兼容)
#   IPv6
#   USB Storage
#   DDNS Cloudflare
#   nlbwmon
#   ttyd
#   WOL
#   Argon
#
# TurboACC：完全移除
# =========================================================
# Target System
# =========================================================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y
# =========================================================
# Firmware Size
# =========================================================
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=960
# =========================================================
# Build
# =========================================================
# CONFIG_CCACHE is not set
# CONFIG_DEVEL is not set
# =========================================================
# Image
#
# 只生成 BIOS/Legacy GRUB combined.img.gz
# 不生成 combined-efi.img.gz
# =========================================================
CONFIG_GRUB_IMAGES=y
# CONFIG_GRUB_EFI_IMAGES is not set
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 不生成 ext4 rootfs
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# 不生成 tar.gz
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# 不生成其他虚拟机镜像
# CONFIG_VMDK_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set
# =========================================================
# LuCI / Basic
# =========================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-accesscontrol=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-ipsec-vpnd=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-onliner=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-wol=y
# =========================================================
# Theme
# =========================================================
CONFIG_PACKAGE_luci-theme-argon=y
# =========================================================
# OpenClash
#
# 按当前 OpenClash Makefile 所需依赖整理
# =========================================================
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_libustream-openssl=y
# =========================================================
# dnsmasq-full
# =========================================================
CONFIG_PACKAGE_dnsmasq-full=y
# 使用 dnsmasq-full
# 不使用普通 dnsmasq
# CONFIG_PACKAGE_dnsmasq is not set
# dnsmasq ipset / nftset
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
# =========================================================
# OpenClash networking
# =========================================================
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
# nftables / firewall4
CONFIG_PACKAGE_kmod-nft-tproxy=y
# iptables compatibility
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_kmod-ipt-nat=y
# IPv6 NAT compatibility
CONFIG_PACKAGE_ip6tables-mod-nat=y
# OpenClash LuCI compatibility
CONFIG_PACKAGE_luci-compat=y
# OpenClash runtime
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y
# =========================================================
# DDNS
# =========================================================
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts_cloudflare.com-v4=y
# =========================================================
# Samba4
#
# 重要：
# 不启用 autosamba，避免与 samba4-server 的
# /etc/hotplug.d/block/20-smb 产生文件冲突
# =========================================================
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_samba4-client=y
CONFIG_PACKAGE_wsdd2=y
# 不使用旧 Samba
# CONFIG_PACKAGE_luci-app-samba is not set
# CONFIG_PACKAGE_samba36-server is not set
# CONFIG_PACKAGE_autosamba is not set
# =========================================================
# Diskman / Disk Management
# =========================================================
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_gptfdisk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_smartmontools=y
# 自动挂载 / fstab
CONFIG_PACKAGE_block-mount=y
# =========================================================
# USB Storage
# =========================================================
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
# =========================================================
# Filesystems
# =========================================================
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
# =========================================================
# IPSec strongswan 6.x IKEv2 PSK + EAP-MSCHAPv2 Full Support【安卓手机增强】
# =========================================================
CONFIG_PACKAGE_luci-app-ipsec-vpnd=y
CONFIG_PACKAGE_strongswan=y
# IPsec内核基础模块
CONFIG_PACKAGE_kmod-ipsec=y
CONFIG_PACKAGE_kmod-xfrm=y
# 内核加密算法模块
CONFIG_PACKAGE_kmod-crypto-aes=y
CONFIG_PACKAGE_kmod-crypto-sha1=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-sha512=y
CONFIG_PACKAGE_kmod-crypto-gcm=y
CONFIG_PACKAGE_kmod-crypto-hmac=y
CONFIG_PACKAGE_kmod-crypto-cbc=y
CONFIG_PACKAGE_kmod-crypto-cmac=y
CONFIG_PACKAGE_kmod-crypto-xcbc=y
# strongswan 核心组件
CONFIG_PACKAGE_strongswan-charon=y
CONFIG_PACKAGE_strongswan-stroke=y
CONFIG_PACKAGE_strongswan-vici=y
CONFIG_PACKAGE_strongswan-libipsec=y
CONFIG_PACKAGE_strongswan-kernel-netlink=y
# 加密算法插件
CONFIG_PACKAGE_strongswan-aes=y
CONFIG_PACKAGE_strongswan-gcm=y
CONFIG_PACKAGE_strongswan-sha1=y
CONFIG_PACKAGE_strongswan-sha2=y
CONFIG_PACKAGE_strongswan-xcbc=y
CONFIG_PACKAGE_strongswan-cmac=y
# 密钥交换、PSK认证插件
CONFIG_PACKAGE_strongswan-modp=y
CONFIG_PACKAGE_strongswan-psk=y
CONFIG_PACKAGE_strongswan-pubkey=y
# 虚拟IP、路由、DNS分配
CONFIG_PACKAGE_strongswan-addrblock=y
CONFIG_PACKAGE_strongswan-curl=y
CONFIG_PACKAGE_strongswan-dnskey=y
CONFIG_PACKAGE_strongswan-fips-prf=y
CONFIG_PACKAGE_strongswan-md4=y
CONFIG_PACKAGE_strongswan-md5=y
CONFIG_PACKAGE_strongswan-random=y
CONFIG_PACKAGE_strongswan-revocation=y
CONFIG_PACKAGE_strongswan-socket-default=y
CONFIG_PACKAGE_strongswan-sqlite=y
CONFIG_PACKAGE_strongswan-unity=y
# ========== 新增：安卓IKEv2 EAP-MSCHAPv2 必备插件 ==========
CONFIG_PACKAGE_strongswan-mod-eap-mschapv2=y
CONFIG_PACKAGE_strongswan-mod-eap-identity=y
CONFIG_PACKAGE_strongswan-mod-eap-tls=y
CONFIG_PACKAGE_strongswan-mod-x509=y
CONFIG_PACKAGE_strongswan-mod-pem=y
CONFIG_PACKAGE_strongswan-mod-pkcs1=y
CONFIG_PACKAGE_strongswan-mod-pkcs7=y
CONFIG_PACKAGE_strongswan-mod-constraints=y
CONFIG_PACKAGE_strongswan-mod-attr=y
CONFIG_PACKAGE_strongswan-mod-updown=y
CONFIG_PACKAGE_strongswan-mod-mobike=y
CONFIG_PACKAGE_strongswan-mod-fragmentation=y
CONFIG_PACKAGE_strongswan-mod-nat-t=y
# =========================================================
# IPv6
# =========================================================
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_ip6tables-extra=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-nf-nat6=y
# =========================================================
# Network Performance / NIC
# =========================================================
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_ethtool=y
# Intel I225 / I226 / I225-V / I226-V
CONFIG_PACKAGE_kmod-igc=y
# Intel I210 / I211 / I219 / related
CONFIG_PACKAGE_kmod-e1000e=y
# Intel 10GbE
CONFIG_PACKAGE_kmod-ixgbe=y
# ip bridge utilities
CONFIG_PACKAGE_ip-bridge=y
# =========================================================
# Network Diagnostic Tools
# =========================================================
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_lsof=y
# ========== 新增网络调试工具 ==========
CONFIG_PACKAGE_tc=y
CONFIG_PACKAGE_nslookup=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_netcat=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_arp-scan=y
CONFIG_PACKAGE_tracepath=y
# =========================================================
# System Tools
# =========================================================
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_sysstat=y
# ========== 新增系统工具 ==========
CONFIG_PACKAGE_pstree=y
CONFIG_PACKAGE_watch=y
CONFIG_PACKAGE_nice=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_kmodinfo=y
# =========================================================
# Storage / Partition Tools
# =========================================================
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_gptfdisk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
# =========================================================
# SSH / SFTP
# =========================================================
CONFIG_PACKAGE_openssh-sftp-server=y
# =========================================================
# Other Utilities
# =========================================================
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
# ========== 证书&openssl工具 ==========
CONFIG_PACKAGE_openssl-util=y
# ========== 文本处理工具 ==========
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_sed=y
CONFIG_PACKAGE_diffutils=y
CONFIG_PACKAGE_file=y
# ========== 压缩工具 ==========
CONFIG_PACKAGE_p7zip=y
CONFIG_PACKAGE_bzip2=y
CONFIG_PACKAGE_xz=y
# =========================================================
# Explicitly disabled packages
# =========================================================
# Access / management
# CONFIG_PACKAGE_luci-app-autoreboot is not set
# CONFIG_PACKAGE_luci-app-filetransfer is not set
# CONFIG_PACKAGE_luci-app-webadmin is not set
# Proxy / DNS alternatives
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-vssr is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set
# Storage / cloud
# CONFIG_PACKAGE_luci-app-alist is not set
# CONFIG_PACKAGE_luci-app-rclone is not set
# CONFIG_PACKAGE_luci-app-cifs-mount is not set
# Network services
# CONFIG_PACKAGE_luci-app-frpc is not set
# CONFIG_PACKAGE_luci-app-arpbind is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-wireguard is not set
# CONFIG_PACKAGE_luci-app-zerotier is not set
# CONFIG_PACKAGE_luci-app-wrtbwmon is not set
# CONFIG_PACKAGE_luci-app-xlnetacc is not set
# Media / misc
# CONFIG_PACKAGE_luci-app-unblockmusic is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# FTP
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# Other
# CONFIG_PACKAGE_luci-app-ramfree is not set
# CONFIG_PACKAGE_luci-app-netdata is not set
# =========================================================
# Disabled software
# =========================================================
# CONFIG_PACKAGE_automount is not set
# CONFIG_PACKAGE_autosamba is not set
# CONFIG_PACKAGE_docker-compose is not set
# CONFIG_PACKAGE_nano-plus is not set
# CONFIG_PACKAGE_snmpd is not set
# =========================================================
# Samba conflict prevention
# =========================================================
# CONFIG_PACKAGE_samba36-server is not set
# CONFIG_PACKAGE_luci-app-samba is not set
# CONFIG_PACKAGE_autosamba is not set
# =========================================================
# TurboACC - completely removed
# =========================================================
# CONFIG_PACKAGE_luci-app-turboacc is not set
# =========================================================
# TurboACC symbols intentionally NOT configured:
#
# CONFIG_TURBOACC_FLOW_OFFLOADING
# CONFIG_TURBOACC_INCLUDE_BBR_CCA
# CONFIG_TURBOACC_INCLUDE_FULLCONENAT
# CONFIG_TURBOACC_INCLUDE_NFT_FULLCONENAT
# CONFIG_TURBOACC_INCLUDE_SHORTCUT_FE
# CONFIG_TURBOACC_INCLUDE_SHORTCUT_FE_DRV
#
# =========================================================
# Explicitly disable unused image formats
# =========================================================
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set
# =========================================================
# End
